# Application ports
WIREMOCK_SERVER_PORT=8222
KTOR_API_PORT=8333
HOST_ADDRESS=0.0.0.0

# WireMock files directory (optional, defaults to classpath:wiremock)
# WIREMOCK_FILES_DIR=/path/to/wiremock/files

# Dynamic allowed ports for proxying
DYN_ALLOWED_PORTS=80,443

# Service map (required) - comma-separated name=url pairs
SERVICE_MAP=testInstanceOfWireMockServer=http://127.0.0.1:5000

# DynamoDB Configuration
DYNAMO_ENDPOINT=http://localhost:8000
AWS_REGION=eu-north-1
DYNAMO_SESSIONS_TABLE=sessions
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

